ENV=dev
GCP_PROJECT_ID=navalha-dev
FIRESTORE_EMULATOR_HOST=localhost:8080
FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
CORS_ORIGINS=["http://localhost:5173"]
SLOT_STEP_MINUTES=30

# Rotas /admin (provisório até a Fase 3). Vazio = desligadas.
ADMIN_API_KEY=troque-esta-chave
# firestore (padrão, usa o emulador em dev) | memory (sem emulador; dados somem ao reiniciar)
REPOSITORY=firestore
# Com REPOSITORY=memory: cria a Barbearia MF ao subir
SEED_DEMO=false
BOOKING_HORIZON_DAYS=60
